{
  "description": "Golden envelope fixtures. Both Swift (RPC module) and Go (internal/rpc) must agree on valid/invalid verdicts. Frames are the JSON text below prefixed with uint32 big-endian byte length.",
  "cases": [
    {"name": "request-minimal", "expect": "valid",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"request\",\"requestId\":\"6f1c1a2e-2c2c-4d0f-9d8a-0f2d1b3c4d5e\",\"method\":\"agent.hello\"}"},
    {"name": "request-with-payload", "expect": "valid",
     "json": "{\"protocol\":\"worker\",\"version\":1,\"kind\":\"request\",\"requestId\":\"r1\",\"method\":\"worker.lease\",\"payload\":{\"ttlMs\":30000}}"},
    {"name": "response-ok", "expect": "valid",
     "json": "{\"protocol\":\"worker\",\"version\":1,\"kind\":\"response\",\"requestId\":\"r1\",\"payload\":{\"leaseExpiresAt\":\"2026-08-25T20:00:00Z\"}}"},
    {"name": "response-error", "expect": "valid",
     "json": "{\"protocol\":\"daemon\",\"version\":1,\"kind\":\"response\",\"requestId\":\"r2\",\"error\":{\"code\":\"VM_NOT_RUNNING\",\"message\":\"virtual machine is not running\",\"retryable\":false}}"},
    {"name": "chunk-middle", "expect": "valid",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"chunk\",\"requestId\":\"r3\",\"method\":\"agent.exec\",\"streamSeq\":3,\"end\":false,\"payload\":{\"stream\":\"stdout\",\"data\":\"aGVsbG8=\"}}"},
    {"name": "chunk-terminal", "expect": "valid",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"chunk\",\"requestId\":\"r3\",\"method\":\"agent.exec\",\"streamSeq\":4,\"end\":true,\"payload\":{\"exitCode\":0}}"},
    {"name": "cancel", "expect": "valid",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"cancel\",\"requestId\":\"r3\"}"},
    {"name": "event", "expect": "valid",
     "json": "{\"protocol\":\"worker\",\"version\":1,\"kind\":\"event\",\"requestId\":\"e1\",\"method\":\"vm.stateChanged\",\"payload\":{\"vmState\":\"running\",\"at\":\"2026-08-25T20:00:00Z\"}}"},
    {"name": "big-int64", "expect": "valid",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"response\",\"requestId\":\"r4\",\"payload\":{\"totalBytes\":9007199254740993}}",
     "note": "9007199254740993 exceeds float64 exactness; decoders must round-trip it exactly as int64"},
    {"name": "invalid-unknown-top-level-key", "expect": "invalid", "reason": "MALFORMED",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"request\",\"requestId\":\"r5\",\"method\":\"agent.hello\",\"extra\":true}"},
    {"name": "invalid-duplicate-key", "expect": "invalid", "reason": "MALFORMED",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"request\",\"requestId\":\"r6\",\"method\":\"agent.hello\",\"method\":\"agent.health\"}"},
    {"name": "invalid-trailing-bytes", "expect": "invalid", "reason": "MALFORMED",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"request\",\"requestId\":\"r7\",\"method\":\"agent.hello\"} x"},
    {"name": "invalid-version", "expect": "invalid", "reason": "PROTOCOL_VERSION",
     "json": "{\"protocol\":\"guest\",\"version\":2,\"kind\":\"request\",\"requestId\":\"r8\",\"method\":\"agent.hello\"}"},
    {"name": "invalid-kind", "expect": "invalid", "reason": "MALFORMED",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"ping\",\"requestId\":\"r9\"}"},
    {"name": "invalid-request-without-method", "expect": "invalid", "reason": "MALFORMED",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"request\",\"requestId\":\"r10\"}"},
    {"name": "invalid-chunk-without-seq", "expect": "invalid", "reason": "MALFORMED",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"chunk\",\"requestId\":\"r11\",\"method\":\"agent.exec\",\"end\":false}"},
    {"name": "invalid-response-with-payload-and-error", "expect": "invalid", "reason": "MALFORMED",
     "json": "{\"protocol\":\"guest\",\"version\":1,\"kind\":\"response\",\"requestId\":\"r12\",\"payload\":{},\"error\":{\"code\":\"X\",\"message\":\"y\"}}"},
    {"name": "invalid-not-object", "expect": "invalid", "reason": "MALFORMED", "json": "[1,2,3]"},
    {"name": "invalid-empty", "expect": "invalid", "reason": "MALFORMED", "json": ""}
  ],
  "framing": [
    {"name": "frame-of-request-minimal", "lengthPrefixHex": "0000007b", "note": "123 bytes = len(request-minimal json)"},
    {"name": "frame-zero-length", "expect": "invalid", "reason": "MALFORMED", "lengthPrefixHex": "00000000"},
    {"name": "frame-over-guest-cap", "expect": "invalid", "reason": "MALFORMED", "lengthPrefixHex": "00400001", "note": "4 MiB + 1 > guest cap"}
  ]
}
