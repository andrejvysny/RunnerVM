# ubuntu-24-node: adds Node.js (NodeSource apt repository) on top of ubuntu-24.
FROM ubuntu-24

ARG NODE_MAJOR=22

LABEL dev.runnervm.image.name="ubuntu-24-node"
LABEL dev.runnervm.image.family="ubuntu-24"

ENV APT="apt-get -y -o DPkg::Lock::Timeout=900 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"

RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL --retry 5 --retry-delay 3 https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      -o /etc/apt/keyrings/nodesource.asc && \
    chmod a+r /etc/apt/keyrings/nodesource.asc && \
    echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/nodesource.asc] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list && \
    $APT update && \
    $APT install nodejs
