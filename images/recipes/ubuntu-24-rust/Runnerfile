# ubuntu-24-rust: adds a rustup-managed toolchain, installed as the runner user, on ubuntu-24.
FROM ubuntu-24

ARG RUST_VERSION=stable

LABEL dev.runnervm.image.name="ubuntu-24-rust"
LABEL dev.runnervm.image.family="ubuntu-24"

ENV HOME=/home/runner
USER runner

RUN curl -fsSL --retry 5 --retry-delay 3 https://sh.rustup.rs -o /tmp/rustup-init.sh && \
    sh /tmp/rustup-init.sh -y --default-toolchain ${RUST_VERSION} --no-modify-path && \
    rm -f /tmp/rustup-init.sh

USER root

RUN echo 'export PATH=\$HOME/.cargo/bin:\$PATH' > /etc/profile.d/rust.sh && \
    chmod 0644 /etc/profile.d/rust.sh
